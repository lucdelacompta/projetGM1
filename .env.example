# --- Serveur ---
PORT=4000
DATABASE_PATH=./data/amateurscore.db

# --- Source FFF (api-dofa) ---
# Base de l'API publique utilisee par fff.fr
FFF_API_BASE=https://api-dofa.fff.fr/api
# User-Agent envoye a la FFF (mettre un contact reel)
FFF_USER_AGENT=AmateurScore/0.1 (+contact@example.org)
# Delai minimum entre deux appels FFF, en ms (respect du serveur)
FFF_RATE_LIMIT_MS=600
# Duree de vie du cache disque des reponses FFF, en secondes
FFF_CACHE_TTL=3600
# Repertoire du cache
FFF_CACHE_DIR=./data/fff-cache
# Mode hors-ligne : utilise les fixtures locales au lieu du reseau (0/1)
FFF_OFFLINE=0
# Numeros de clubs FFF a suivre (cl_no), separes par des virgules
FFF_CLUBS=
